    const n = inputString[idx++];
    const p = [];
    for (let i = 0; i < n; i++) p.push(inputString[idx++]);
    const x = [];
    for (let i = 0; i < n; i++) x.push(inputString[idx++]);
    const m = inputString[idx++];
    const y = [];
    for (let j = 0; j < m; j++) y.push(inputString[idx++]);
    const r = [];
    for (let j = 0; j < m; j++) r.push(inputString[idx++]);

    const result = maximumPeople(p, x, y, r);
    console.log(result);
});
